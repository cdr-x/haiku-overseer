<section class=3D"ltx_section" id=3D"S1">
<h2 class=3D"ltx_title ltx_title_section">
<span class=3D"ltx_tag ltx_tag_section">1 </span>Introduction</h2><button c=
lass=3D"sr-only button" style=3D"display: none;">Report issue for preceding=
 element</button>
<figure class=3D"ltx_figure" id=3D"S1.F1"><img alt=3D"Refer to caption" cla=
ss=3D"ltx_graphics ltx_centering ltx_img_square" height=3D"317" id=3D"S1.F1=
